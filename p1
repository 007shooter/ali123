# Importing the libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Reading the dataset
dataset = pd.read_csv("advertising.csv")

# Setting the value for X and Y
x = dataset[['TV']]
y = dataset['Sales']

# Splitting the dataset
from sklearn.model_selection import train_test_split

x_train, x_test, y_train, y_test = train_test_split(
    x, y, test_size=0.3, random_state=100
)

# Fitting the Linear Regression model
from sklearn.linear_model import LinearRegression

slr = LinearRegression()
slr.fit(x_train, y_train)

# Intercept and Coefficient
print("Intercept:", slr.intercept_)
print("Coefficient:", slr.coef_)

# Regression Equation
print("Regression Equation:")
print("Sales =", slr.intercept_, "+", slr.coef_[0], "* TV")

# Prediction of test set
y_pred_slr = slr.predict(x_test)

print("\nPrediction for test set:")
print(y_pred_slr)

# Actual value and predicted value
slr_diff = pd.DataFrame({
    'Actual value': y_test,
    'Predicted value': y_pred_slr
})

print("\nActual vs Predicted:")
print(slr_diff.head())

# Line of best fit
plt.scatter(x_test, y_test)
plt.plot(x_test, y_pred_slr, 'r')
plt.xlabel("TV Advertising")
plt.ylabel("Sales")
plt.title("Linear Regression")
plt.show()

# Model Evaluation
from sklearn import metrics

meanAbErr = metrics.mean_absolute_error(y_test, y_pred_slr)
meanSqErr = metrics.mean_squared_error(y_test, y_pred_slr)
rootMeanSqErr = np.sqrt(meanSqErr)

print("\nModel Evaluation")
print('R squared:', slr.score(x, y) * 100)
print('Mean Absolute Error:', meanAbErr)
print('Mean Square Error:', meanSqErr)
print('Root Mean Square Error:', rootMeanSqErr)
